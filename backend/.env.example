[TEMPLATE]
# ---- App ----
APP_NAME=Mediqo
DEBUG=true

# ---- Database (PostgreSQL) ----
# Local dev database used by the MVP. Change credentials for your environment.
DATABASE_URL=postgresql://mediqo:mediqo_dev@localhost:5432/mediqo

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI provider (Step 5) ----
# "keyword"   = offline deterministic rule-based analyzer (no key needed —
#               ideal for the MVP demo and for tests)
# "openai"    = any OpenAI-compatible chat-completions API
# "snowflake" = Snowflake Cortex REST API via its OpenAI-compatible Chat
#               Completions endpoint. Set AI_BASE_URL to your account's
#               Cortex v1 base URL and AI_API_KEY to a Snowflake PAT.
#               Production example:
#               AI_PROVIDER=snowflake
#               AI_API_KEY=<Snowflake PAT>
#               AI_MODEL=openai-gpt-5-mini
#               AI_BASE_URL=https://<account>.snowflakecomputing.com/api/v2/cortex/v1
#               AI_TIMEOUT_SECONDS=10
AI_PROVIDER=keyword
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=10

# NEVER commit real API keys. Put them only in your local .env (gitignored).
# With AI_PROVIDER=openai/snowflake and an empty AI_API_KEY, the service
# automatically falls back to the rule-based provider and logs a warning.
